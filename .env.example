# Google Places API — fotos y datos de Google Maps
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Producción — guiamontilla.es
SITE_URL=https://guiamontilla.es
BASE_PATH=/

# Despliegue IONOS (solo en GitHub Secrets, no subir aquí):
# IONOS_FTP_SERVER=accessXXXX.webspace-data.io
# IONOS_FTP_USERNAME=tu-usuario-ftp
# IONOS_FTP_PASSWORD=tu-contraseña
# IONOS_FTP_SERVER_DIR=/Guiamontilla/

# Opcional — reescritura IA en pipeline de eventos:
GEMINI_API_KEY=

# Google AdSense — cuenta nueva (debe coincidir con public/ads.txt)
# PUBLIC_ADSENSE_CLIENT=ca-pub-2670243335449541
# Unidades display (AdSense → Anuncios → Por unidad). Sin ID = no se muestra unidad manual:
# PUBLIC_ADSENSE_SLOT_BLOG_ASIDE=
# PUBLIC_ADSENSE_SLOT_IN_CONTENT=
# PUBLIC_ADSENSE_SLOT_CATEGORY_MID=
# PUBLIC_ADSENSE_SLOT_HOME=

# Stripe Payment Links (Dashboard → Productos → Enlace de pago)
# PUBLIC_STRIPE_PAYMENT_LINK_DESTACADO=https://buy.stripe.com/...
# PUBLIC_STRIPE_PAYMENT_LINK_BANNER=
# PUBLIC_STRIPE_PAYMENT_LINK_PATROCINIO=
